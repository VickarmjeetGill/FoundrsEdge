generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model businesses {
  id                          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id                   String?   @db.Uuid
  business_name               String
  business_desc               String?
  website                     String?
  revenue                     String?
  employees                   String?
  business_type               String?
  geographic_focus            String[]
  ideal_client_industries     String[]
  referral_partner_industries String[]
  priorities                  String[]
  open_to_matching            Boolean?  @default(true)
  status   String  @default("PENDING")
featured Boolean @default(false)
removed  Boolean @default(false)
  created_at                  DateTime? @default(now()) @db.Timestamptz(6)
  business_directory          business_directory?
  members                     members?  @relation(fields: [member_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  offers                      offers[]

  //indexing the member_id foreign key
  @@index([member_id])
  @@index([business_name])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model members {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  first_name  String
  last_name   String
  email       String        @unique
  phone       String?
  linkedin    String?
  stage       String?
  industry    String?
  created_at  DateTime?     @default(now()) @db.Timestamptz(6)
  businesses  businesses[]
  events      events[]
  offers      offers[]
  nominations nominations[]
}

model User {
  id                  String   @id @default(cuid())
  email               String   @unique
  password            String
  name                String?
  refreshToken        String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  role                String   @default("MEMBER")
  status              String   @default("ACTIVE")

  avatarUrl           String?
  track               String?
  completedMilestones String[]


  roadmapProgress UserRoadmapProgress[]
  scorecardSubmissions ScorecardSubmission[]
  chatSessions ChatSession[]

  @@index([role])
  @@index([status])
}

model ChatSession {
  id        String        @id @default(cuid())
  userId    String
  title     String        @default("New Coaching Session")
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  messages  ChatMessage[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model ChatMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String   // "user" | "assistant"
  content   String
  createdAt DateTime @default(now())

  session ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
}

model ScorecardSubmission {
  id          String   @id @default(cuid())
  userId      String
  score       Int
  answers     Json     // Array of { questionId: string, category: string, score: number }
  categories  Json     // Map of category -> score (e.g., { "Finance": 80, "Sales": 60 })
  goals       Json?    // Map of goal category -> target value
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}


model RoadmapStep {
  id String @id @default(cuid())
  track String 
  weekNumber Int
  title String
  description String
  actionText String
  actionHref String
  order Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  progress UserRoadmapProgress[]

  @@index([track])
  @@index([track, order])
}

model UserRoadmapProgress {
  id String @id @default(cuid())
  userId String
  stepId String
  completed Boolean @default(false)
  completedAt DateTime?

  user User @relation(fields: [userId], references :[id], onDelete: Cascade)
  step RoadmapStep @relation(fields: [stepId], references :[id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId])
  @@index([stepId])

}

model offers {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  member_id       String?     @db.Uuid
  business_id     String?     @db.Uuid
  business_name   String
  category        String
  type            String
  discount_value  String?
  title           String
  description     String
  location        String?
  expiry_date     DateTime
  fe_discount     String?
  events_page_url String?
  how_to_redeem   String?
  is_affiliate    Boolean     @default(false)
  status          String      @default("PENDING")
  created_at      DateTime    @default(now()) @db.Timestamptz(6)
  updated_at      DateTime    @updatedAt @db.Timestamptz(6)
  featured        Boolean     @default(false)
  businesses      businesses? @relation(fields: [business_id], references: [id])
  members         members?    @relation(fields: [member_id], references: [id])
  is_passport     Boolean @default(false)
  passport_type String? 
  promo_code    String? 
  business_directory_id String?             @db.Uuid
  discount_category     String?
  discount_template     String?
  business_directory    business_directory? @relation(fields: [business_directory_id], references: [id])

  @@index([member_id])
  @@index([business_id])
  @@index([status])
  @@index([category])
  @@index([type])
  @@index([status, expiry_date])
  @@index([created_at])
  @@index([is_passport])
  @@index([business_directory_id])
}

/// Resource partners (organizations that supply curated resources to the hub).
model partners {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  description   String?
  short_desc    String?     @map("short_desc")
  long_desc     String?     @map("long_desc")
  website       String?
  logo_url      String?     @map("logo_url")
  category      String?
  contact_email String?
  status        String      @default("ACTIVE")
  featured      Boolean     @default(false)
  created_at    DateTime    @default(now()) @db.Timestamptz(6) @map("created_at")
  updated_at    DateTime    @updatedAt @db.Timestamptz(6) @map("updated_at")
  resources     resources[]

  @@index([name])
  @@index([status])
}

/// Curated resources shown on the Resources hub; optionally attached to a partner.
model resources {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  partner_id  String?   @db.Uuid @map("partner_id")
  title       String
  description String?
  url         String?
  type        String?
  category    String
  tags        String[]  @default([])
  featured    Boolean   @default(false)
  status      String    @default("PUBLISHED")
  created_at  DateTime  @default(now()) @db.Timestamptz(6) @map("created_at")
  updated_at  DateTime  @updatedAt @db.Timestamptz(6) @map("updated_at")
  partner     partners? @relation(fields: [partner_id], references: [id], onDelete: SetNull)

  @@index([partner_id])
  @@index([category])
  @@index([status])
}


model events {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title          String
  description    String
  date           String
  time           String
  location       String
  category       String
  price          String
  host           String
  attendees      Int         @default(0)
  featured       Boolean     @default(false)
  status         EventStatus @default(PENDING)
  member_id      String?     @db.Uuid
  source         String      @default("member")
  guest_name     String?     @map("guestName")
  guest_email    String?     @map("guestEmail")
  guest_business String?     @map("guestBusiness")
  created_at     DateTime?   @default(now()) @db.Timestamptz(6)
  updated_at     DateTime?   @db.Timestamptz(6)
  tags           String[]    @default([])
  capacity       Int         @default(50)
  duration       String      @default("2 hrs")
  members        members?    @relation(fields: [member_id], references: [id], onDelete: Cascade)

  @@index([member_id])
  @@index([status])
  @@index([category])
  @@index([featured, created_at])
}

enum EventStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

model awards {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  org             String
  category        String
  region          String
  deadline        String
  award_date      String   @map("awardDate")
  value           String
  cycle           String
  desc            String
  featured        Boolean  @default(false)
  nominationsOpen Boolean  @default(true) @map("nominationsOpen")
  sponsor         String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  nominations nominations[]

  @@index([category])
  @@index([region])
  @@index([featured])
  @@index([nominationsOpen])
  @@index([deadline])
}

model nominations {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  award_id      String   @db.Uuid
  member_id     String?  @db.Uuid
  business_name String
  contact_name  String
  contact_email String
  website       String?
  achievement   String
  statement     String
  status        String   @default("PENDING")
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  updated_at    DateTime @updatedAt @db.Timestamptz(6)

  award   awards   @relation(fields: [award_id], references: [id], onDelete: Cascade)
  members members? @relation(fields: [member_id], references: [id], onDelete: SetNull)

  @@index([award_id])
  @@index([member_id])
  @@index([status])
  @@index([created_at])
}

model posts {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_name     String
  author_business String?
  content         String
  linked_type     String?
  linked_title    String?
  linked_subtitle String?
  linked_url      String?
  like_count      Int      @default(0)
  comment_count   Int      @default(0)
  flag_count      Int      @default(0)
  removed         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  comments      comments[]
  flag_reports  flag_reports[]
  notifications notifications[]

  @@index([removed, created_at])
}

model comments {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  post_id         String   @db.Uuid
  parent_id       String?  @db.Uuid
  author_name     String
  author_business String?
  content         String
  like_count      Int      @default(0)
  removed         Boolean  @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @updatedAt @db.Timestamptz(6)

  post         posts          @relation(fields: [post_id], references: [id], onDelete: Cascade)
  flag_reports flag_reports[]

  @@index([post_id])
  @@index([parent_id])
}

model flag_reports {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  content_type    String
  content_id      String   @db.Uuid
  content_preview String
  author_name     String
  reported_by     String
  reason          String
  details         String?
  status          String   @default("pending")
  reported_at     DateTime @default(now()) @db.Timestamptz(6)

  post_id    String? @db.Uuid
  comment_id String? @db.Uuid

  post    posts?    @relation(fields: [post_id], references: [id], onDelete: Cascade)
  comment comments? @relation(fields: [comment_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@index([comment_id])
  @@index([reported_at])
}

model notifications {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       String
  message    String
  post_id    String?   @db.Uuid
  read       Boolean   @default(false)
  created_at DateTime? @default(now()) @db.Timestamptz(6)

  post posts? @relation(fields: [post_id], references: [id], onDelete: Cascade)

  @@index([post_id])
  @@index([created_at])
}

model likes {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  target_type     String
  target_id       String   @db.Uuid
  user_identifier String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  @@unique([target_type, target_id, user_identifier])
}

model post_email_usage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email      String   @unique
  post_count Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  @@index([email])
}

model opportunities {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String
  type        String   // Grants, Events, Speaking, Funding, Pitch, Media, Procurement
  deadline    String?
  source_url  String
  featured    Boolean  @default(false)
  status      String   @default("ACTIVE")
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @updatedAt @db.Timestamptz(6)

  @@index([type])
  @@index([featured])
  @@index([status])
}

model DiscountTemplates {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category             String
  template_label       String
  template_description String
  is_recommended       Boolean  @default(false)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @db.Timestamptz(6)

  @@index([category])
  @@index([is_recommended])
}

model business_directory {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  business_id   String     @unique @db.Uuid
  name          String
  category      String?
  description   String?
  logo_url      String?
  website       String?
  location      String?
  contact_email String?
  is_featured   Boolean    @default(false)
  status        String     @default("PENDING")
  created_at    DateTime   @default(now()) @db.Timestamptz(6)
  updated_at    DateTime   @db.Timestamptz(6)
  businesses    businesses @relation(fields: [business_id], references: [id], onDelete: Cascade)
  offers        offers[]

  @@index([category])
  @@index([is_featured])
  @@index([status])
}



